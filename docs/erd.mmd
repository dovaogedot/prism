%%{init: {"htmlLabels": false}}%%
erDiagram
  app_user {
    uuid id PK
    bytea email "encrypted"
    bytea email_index UK "blind index of the email"
    text password_hash "null for a provider-only account"
    bytea totp_secret "encrypted; null until 2FA setup starts"
    timestamptz totp_enabled_at "null until a code confirms the secret"
    bigint totp_last_step "the last accepted code's time step"
    text[] roles "staff roles; empty for a customer"
    bytea full_name "encrypted; null until set"
    bytea phone "encrypted; null until set"
    timestamptz disabled_at "set while an admin has it disabled"
    timestamptz created_at
  }
  oauth_identity {
    uuid id PK
    uuid user_id FK
    text provider "unique with subject_index"
    bytea subject "encrypted; the provider's own user id"
    bytea subject_index "blind index of the subject"
    timestamptz created_at
  }
  session {
    uuid id PK
    uuid user_id FK
    timestamptz created_at
    timestamptz expires_at
    timestamptz revoked_at "null while live"
    text revoked_reason "set exactly when revoked_at is"
    bytea user_agent "encrypted"
    bytea ip_address "encrypted"
    timestamptz second_factor_at "when it last passed a TOTP check"
  }
  refresh_token {
    uuid id PK
    uuid session_id FK
    text token_hash UK "SHA-256 of the token"
    timestamptz created_at
    timestamptz expires_at
    timestamptz used_at "set on rotation; a second use is a replay"
  }
  password_reset_token {
    uuid id PK
    uuid user_id FK
    text token_hash UK
    timestamptz created_at
    timestamptz expires_at
    timestamptz used_at
  }
  address {
    uuid id PK
    uuid user_id FK
    bytea details "encrypted: label, name, phone and address"
    boolean is_default "at most one per user"
    timestamptz created_at
    timestamptz updated_at
  }
  audit_event {
    bigint id PK
    uuid actor_id FK "null for the system"
    text[] actor_roles "the actor's roles at the time"
    text action "such as product.update"
    text target_type
    text target_id "null without a single target"
    text summary "one line a person reads"
    jsonb changes "fields before and after, no personal values"
    bytea ip "encrypted"
    timestamptz created_at "rows are never updated or deleted"
  }
  category {
    uuid id PK
    text slug UK
    text name
    text description "null until written"
  }
  brand {
    uuid id PK
    text slug UK
    text name
  }
  product {
    uuid id PK
    text slug UK
    text name "trigram index for similar names"
    text description
    integer price_cents "not negative"
    integer stock "not negative"
    uuid category_id FK
    uuid brand_id FK
    integer weight_grams "positive"
    integer width_mm "positive"
    integer height_mm "positive"
    integer depth_mm "positive"
    timestamptz featured_at "null when not on the home page"
    float8 rating_average "of the approved reviews; 0 without any"
    integer rating_count "approved reviews; a trigger keeps both"
    timestamptz created_at
    timestamptz updated_at
    tsvector search "generated from name and description"
  }
  product_property {
    uuid product_id PK, FK
    text name PK
    text value
  }
  product_image {
    uuid id PK
    uuid product_id FK
    text file "the source file under the media directory"
    text alt
    integer position "unique per product"
    integer width "null until the smaller copies exist"
    integer height "set exactly when width is"
    boolean is_pixel_art "scaled without smoothing"
  }
  product_review {
    uuid id PK
    uuid product_id FK
    uuid user_id FK "unique with product_id"
    smallint rating "1 to 5"
    text author_name "2 to 40 characters"
    text title "null, or 1 to 120 characters"
    text body "null, or 1 to 2000 characters"
    text status "pending, approved or rejected"
    text rejection_reason "set exactly when rejected"
    integer helpful_count "not negative"
    uuid moderated_by FK "null until moderated"
    timestamptz moderated_at
    timestamptz created_at
    timestamptz updated_at
  }
  review_vote {
    uuid review_id PK, FK
    uuid user_id PK, FK
    timestamptz created_at
  }
  shipping_method {
    text code PK "a slug"
    text name
    integer price_cents "not negative"
    integer free_from_cents "null when it never ships free"
    integer min_days "business days, at least 1"
    integer max_days "from min_days to 30"
    boolean is_active
    integer position "where the checkout lists it"
    timestamptz created_at
    timestamptz updated_at
  }
  cart {
    uuid id PK
    uuid user_id FK, UK "null for a guest cart"
    text token_hash UK "SHA-256 of the guest cookie; null for a user cart"
    timestamptz created_at
    timestamptz updated_at
    timestamptz expires_at "set exactly for a guest cart"
  }
  cart_item {
    uuid cart_id PK, FK
    uuid product_id PK, FK
    integer quantity "1 to 99"
    timestamptz added_at
  }
  customer_order {
    uuid id PK
    integer number UK "from 100001"
    uuid user_id FK "null for a guest order"
    uuid cart_id FK "the cart it was placed from"
    text status "one of the eight statuses"
    text shipping_method FK "the delivery option's code"
    text shipping_method_name "as chosen"
    date estimated_delivery_from
    date estimated_delivery_to "not before the first day"
    integer subtotal_cents
    integer shipping_cents
    integer total_cents "subtotal plus shipping"
    bytea contact "encrypted: name, email, phone"
    bytea shipping_address "encrypted"
    bytea billing_address "encrypted; null when it is the shipping address"
    bytea email_index "blind index of the contact email"
    bytea access_key "encrypted; guest orders only"
    text tracking_number "required once shipped"
    timestamptz refunded_at
    timestamptz payment_due_at
    timestamptz created_at
    timestamptz status_changed_at
  }
  order_line {
    uuid id PK
    uuid order_id FK
    uuid product_id FK "null once the product is gone"
    text product_name "as sold"
    text product_slug "as sold"
    integer unit_price_cents "as sold"
    integer quantity "at least 1"
    integer line_total_cents "unit price times quantity"
  }
  order_event {
    bigint id PK
    uuid order_id FK
    text status
    text note "null when the status says it all"
    timestamptz created_at
  }
  payment {
    uuid id PK
    uuid order_id FK "unique with kind"
    text kind "charge or refund"
    text status "pending, succeeded, failed or canceled"
    integer amount_cents
    text provider
    bytea reference "encrypted Stripe id"
    bytea details "encrypted card brand, last four, failure"
    timestamptz created_at
    timestamptz updated_at
  }
  outbox_message {
    uuid id PK "also the message id"
    text exchange
    text routing_key
    jsonb payload "ids and codes only"
    timestamptz created_at
    timestamptz published_at "null until published"
  }

  app_user ||--|| cart : "keeps"
  app_user ||--o{ oauth_identity : "signs in through"
  app_user ||--o{ session : "opens"
  session ||--o{ refresh_token : "issues"
  app_user ||--o{ password_reset_token : "requests"
  app_user ||--o{ address : "saves"
  app_user ||--o{ audit_event : "acts in"
  app_user ||--o{ product_review : "writes"
  app_user ||--o{ product_review : "moderates"
  app_user ||--o{ review_vote : "casts"
  product_review ||--o{ review_vote : "earns"
  category ||--o{ product : "files"
  brand ||--o{ product : "makes"
  product ||--o{ product_property : "carries"
  product ||--o{ product_image : "shows"
  product ||--o{ product_review : "receives"
  cart ||--o{ cart_item : "holds"
  product ||--o{ cart_item : "is in"
  app_user ||--o{ customer_order : "places"
  cart ||--o{ customer_order : "is checked out as"
  shipping_method ||--o{ customer_order : "delivers"
  customer_order ||--o{ order_line : "lists"
  product ||--o{ order_line : "is sold as"
  customer_order ||--o{ order_event : "records"
  customer_order ||--o{ payment : "is paid by"
