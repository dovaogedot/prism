# Copy to .env — or just run ./start.sh, which does it for you and fills in a
# random JWT_SECRET. Every value below has a working default, so the stack comes
# up with no external accounts of any kind.

# --------------------------------------------------------------------- secrets
# openssl rand -hex 32
JWT_SECRET=change-me-to-64-hex-characters-openssl-rand-hex-32-abcdef012345
POSTGRES_PASSWORD=prism

# Requests per address per minute on /auth/*. Anything that checks a credential
# gets this; a session refresh gets three times it, and every page load makes
# one, so a browser opening pages quickly needs more headroom than a person
# signing in does.
AUTH_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------ mail
# Password-reset messages go to the Mailpit container by default — a local
# inbox at http://localhost:8025, not your real one. Point these at a real
# relay to send real email; both credentials are needed, and TLS with them.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_SECURE=false          # true for implicit TLS on 465
# MAIL_FROM=Prism <noreply@yourdomain.example>

# ----------------------------------------------------------------------- ports
WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info

# --------------------------------------------------------------------- CAPTCHA
# test   — accepts Google's official always-pass test token, no network call.
#          The browser gets Google's public test site key, so the widget is real
#          and always solves. This is what makes a zero-secret review possible.
# google — verifies against Google siteverify with your own keys.
CAPTCHA_MODE=test
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ----------------------------------------------------------------------- OAuth
# mock — completes the authorization-code dance locally against a built-in
#        provider, so every sign-in button works offline. Both providers are
#        offered.
# live — real OAuth. A provider is offered only if BOTH its id and secret are
#        set, so configuring just one of the two is a valid setup.
#
# Authorized redirect URIs:
#   http://localhost:3000/api/v1/auth/oauth/google/callback
#   http://localhost:3000/api/v1/auth/oauth/github/callback
#
# The GitHub app needs the `read:user` and `user:email` scopes — without
# user:email, accounts with a private address cannot sign in.
OAUTH_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
