# Copy to .env — or just run ./start.sh, which does it for you and fills in a
# random JWT_SECRET. Every value below has a working default, so the stack comes
# up with no external accounts of any kind.

# 64 hex characters:  openssl rand -hex 32
JWT_SECRET=change-me-to-64-hex-characters-openssl-rand-hex-32-abcdef012345

# Any string. Only read when Postgres first initializes its data directory, so
# changing it later does nothing until the volume is dropped.
POSTGRES_PASSWORD=prism

# Scheme and host, no trailing slash. Password-reset links and OAuth redirect
# URIs are built from it, so it has to match what people actually type.
PUBLIC_WEB_URL=http://localhost:3000

# Port number. The host port the storefront listens on; a deployment points its
# reverse proxy here.
WEB_PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Whole number. Requests per address per minute on /auth/*. Every page load
# refreshes a session, so this needs more headroom than a person signing in.
AUTH_RATE_LIMIT_PER_MINUTE=60

# Unset: password-reset mail goes to the Mailpit container, readable at :8025.
# Set these to send real mail — both credentials are needed, and TLS with them.
# From your mail provider's SMTP page.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587                          # 587 with STARTTLS, 465 implicit
# SMTP_USER=apikey
# SMTP_PASSWORD=...
# SMTP_SECURE=false                      # true for implicit TLS on 465
# MAIL_FROM=Prism <noreply@yourdomain.example>

# Empty: registration accepts Google's always-pass test token and the browser
# gets their public test site key, so the widget is real and always solves.
# Fill both in and the same code path verifies for real.
#
# From https://www.google.com/recaptcha/admin — register a site, type
# "Challenge (v2)" > "I'm not a robot" checkbox, and add your domain. Both keys
# start with 6L and are about 40 characters. The site key is public and is read
# when the web image is built, so changing it needs a rebuild, not a restart.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Empty: every sign-in button completes against a built-in provider, offline.
# Fill in a pair and that provider becomes real — one pair is enough, and half
# a pair counts as none.
#
# Google: console.cloud.google.com > APIs & Services > Credentials > Create
# credentials > OAuth client ID > Web application. The id ends in
# .apps.googleusercontent.com and the secret starts with GOCSPX-.
#
# GitHub: github.com/settings/developers > New OAuth App. The id looks like
# Ov23li..., the secret is 40 hex characters, and the app needs the read:user
# and user:email scopes — without user:email, accounts with a private address
# cannot sign in.
#
# Both need this as an authorized redirect URI:
#   <PUBLIC_WEB_URL>/api/v1/auth/oauth/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# --- deploying ---------------------------------------------------------------
# The workflow writes this file on the server itself, from the repository's
# settings under Settings > Secrets and variables > Actions.
#
# One-time setup on the server:
#
#   curl -fsSL https://get.docker.com | sudo sh
#   sudo usermod -aG docker <user>            # log out and back in
#
# One-time setup for the connection, run locally:
#
#   ssh-keygen -t ed25519 -N '' -f ~/.ssh/prism_deploy
#   ssh-copy-id -i ~/.ssh/prism_deploy.pub <user>@<host>
#   cat ~/.ssh/prism_deploy                   # this goes in DEPLOY_SSH_KEY
#
# Secrets    DEPLOY_HOST                  example.com, or an IP
#            DEPLOY_USER                  the account you ssh in as
#            DEPLOY_SSH_KEY               the whole private key file, including
#                                         the BEGIN and END lines
#            JWT_SECRET                   as above
#            POSTGRES_PASSWORD            as above, set before the first deploy
#            RECAPTCHA_SITE_KEY           optional, as above
#            RECAPTCHA_SECRET_KEY         optional, as above
#            GOOGLE_CLIENT_ID             optional, as above
#            GOOGLE_CLIENT_SECRET         optional, as above
#            OAUTH_GITHUB_CLIENT_ID       optional; the OAUTH_ prefix is there
#            OAUTH_GITHUB_CLIENT_SECRET   because Actions reserves GITHUB_*
#
# Variables  PUBLIC_WEB_URL               https://shop.example.com — required,
#                                         no default, must match the real address
#            WEB_PORT                     8090 by default; loopback only
#            MAILPIT_PORT                 8026 by default; loopback only
#            MAIL_FROM                    Prism <noreply@shop.example.com>
#            AUTH_RATE_LIMIT_PER_MINUTE   60 by default
#            DEPLOY_PATH                  ~/prism by default
#
# Then point the subdomain at WEB_PORT, and the inbox at MAILPIT_PORT if a
# reviewer needs to open a reset link (caddy hash-password for the hash):
#
#   shop.example.com      { reverse_proxy 127.0.0.1:8090 }
#   mail.shop.example.com { basic_auth { reviewer <hash> }
#                           reverse_proxy 127.0.0.1:8026 }
