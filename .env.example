# Copy to .env, or just run ./start.sh (start.cmd on Windows), which does it
# for you. Every value below has a working default, so the stack comes up with
# no external accounts of any kind.

# Signs the sessions. This value is public, so it is good for a local run only;
# anywhere else put your own 64 hex characters:  openssl rand -hex 32
JWT_SECRET=a7b6f373e832d7c6d98dd79c02862253540568996e1d74d8b2cabfd6eee11a21

# Any string. Only read when Postgres first initializes its data directory, so
# changing it later does nothing until the volume is dropped.
POSTGRES_PASSWORD=prism

# Scheme and host, no trailing slash. Password-reset links and OAuth redirect
# URIs are built from it, so it has to match what people actually type.
PUBLIC_WEB_URL=https://localhost:3000

# Port number. The host port the storefront listens on; a deployment points its
# reverse proxy here.
WEB_PORT=3000

# self-signed | off. self-signed serves the storefront over HTTPS with a
# certificate the web container makes for localhost on its first start; the
# browser warns once, because nobody vouches for it. off serves plain HTTP, for
# a server whose own reverse proxy holds a real certificate.
WEB_TLS=self-signed

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# A positive number that multiplies every rate limit's capacity and refill
# rate. 1 is the shop's real budgets; only test and load-test stacks raise it.
RATE_LIMIT_SCALE=1

# Unset: mail goes to the Mailpit container, readable at :8025 as
# prism / MAILPIT_PASSWORD.
# Set these to send real mail. Both credentials are needed, and TLS with them.
# From your mail provider's SMTP page.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587                          # 587 with STARTTLS, 465 implicit
# SMTP_USER=apikey
# SMTP_PASSWORD=...
# SMTP_SECURE=false                      # true for implicit TLS on 465
# MAIL_FROM=Prism <noreply@yourdomain.example>

# The inbox the contact form writes to. Locally Mailpit catches it.
SUPPORT_EMAIL=support@prism.shop

# Empty: registration accepts Google's always-pass test token and the browser
# gets their public test site key, so the widget is real and always solves.
# Fill both in and the same code path verifies for real.
#
# From https://www.google.com/recaptcha/admin: register a site, type
# "Challenge (v2)" > "I'm not a robot" checkbox, and add your domain. Both keys
# start with 6L and are about 40 characters. The site key is public and is read
# when the web image is built, so changing it needs a rebuild, not a restart.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Empty: every sign-in button completes against a built-in provider, offline.
# Fill in a pair and that provider becomes real. One pair is enough, and half
# a pair counts as none.
#
# Google: console.cloud.google.com > APIs & Services > Credentials > Create
# credentials > OAuth client ID > Web application. The id ends in
# .apps.googleusercontent.com and the secret starts with GOCSPX-.
#
# GitHub: github.com/settings/developers > New OAuth App. The id looks like
# Ov23li..., the secret is 40 hex characters, and the app needs the read:user
# and user:email scopes; without user:email, accounts with a private address
# cannot sign in.
#
# Both need this as an authorized redirect URI:
#   <PUBLIC_WEB_URL>/api/v1/auth/oauth/<google|github>/callback
# which on a laptop is https://localhost:3000/api/v1/auth/oauth/google/callback
# and https://localhost:3000/api/v1/auth/oauth/github/callback.
#
# The OAUTH_ prefix keeps each name the same from the deploy settings to the
# API, because Actions refuses a secret name that starts with GITHUB_.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Encrypts every column in the database that identifies a person: accounts,
# saved addresses, orders, sessions and the addresses in the audit log. Public
# like JWT_SECRET above, so good for a local run only;
# anywhere else put your own:  openssl rand -hex 32
# Changing it makes everything already sealed unreadable: accounts, saved
# addresses and orders alike.
DATA_ENCRYPTION_KEY=4920704bd2b6bfb9256c7a8172626830028ff161106fc4884ef34e8a5c39a0c8

# The shop's first admin. At start, when no account holds the admin role, the
# account with ADMIN_EMAIL gets it: a new account is created with this
# password and with two-factor authentication already on under
# ADMIN_TOTP_SECRET, and an existing account keeps its own password and 2FA.
# Once an admin exists, these change nothing. Set all three or none.
#
# The password follows the registration rules: at least 12 characters, and
# not a common one. The 2FA key is base32 of at least 32 characters; type it
# into an authenticator app (Google Authenticator, Aegis, 1Password: "enter a
# setup key", time-based) and sign in with the 6-digit codes it shows. These
# values are public, so they are good for a local run only; anywhere else make
# a key with:  head -c 20 /dev/urandom | base32
ADMIN_EMAIL=admin@prism.shop
ADMIN_PASSWORD=admin-prism-admin
ADMIN_TOTP_SECRET=CFBNJ5LGD7BVFZHEQTQTFJR5CQCI6KYS

# Letters and digits. Like POSTGRES_PASSWORD, only read when RabbitMQ first
# initializes its volume.
RABBITMQ_PASSWORD=prism

# Port number. The RabbitMQ management UI, signed in as prism / the password
# above.
RABBITMQ_UI_PORT=15672

# Letters and digits. The Mailpit inbox signs in as prism / this.
MAILPIT_PASSWORD=prism

# Empty: the cart works, and checkout says payments are not set up. Fill both
# in to take test payments; nothing is charged in test mode.
#
# From https://dashboard.stripe.com/test/apikeys (Developers > API keys, with
# "Test mode" on). The secret key starts with sk_test_, the publishable key
# with pk_test_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Brings up the Stripe CLI as a container that forwards Stripe's webhooks to
# the API, so a laptop needs no public address and no CLI of its own. Remove
# the line to run `stripe listen` on the host instead, and put the secret it
# prints into STRIPE_WEBHOOK_SECRET.
COMPOSE_PROFILES=stripe

# Milliseconds the API waits for Stripe. Set it to 1 and restart the api to
# see what a customer sees when the payment provider times out.
STRIPE_TIMEOUT_MS=10000

# stripe | simulated. stripe takes test payments once both keys above are
# set. simulated needs no Stripe account: placing an order pays for it at
# once and nothing is charged, which suits a demo without keys. The API
# refuses simulated unless PUBLIC_WEB_URL is on localhost.
PAYMENTS_MODE=stripe


# --- deploying ---------------------------------------------------------------
# The workflow writes this file on the server itself, from the secrets and
# variables of the repository's production environment (Settings >
# Environments > production). Only main can deploy to that environment.
#
# One-time setup on the server:
#
#   curl -fsSL https://get.docker.com | sudo sh
#   sudo usermod -aG docker <user>            # log out and back in
#
# One-time setup for the connection, run locally:
#
#   ssh-keygen -t ed25519 -N '' -f ~/.ssh/prism_deploy
#   ssh-copy-id -i ~/.ssh/prism_deploy.pub <user>@<host>
#   cat ~/.ssh/prism_deploy                   # this goes in DEPLOY_SSH_KEY
#   ssh-keygen -F <host>                      # the line under the comment goes
#                                             # in DEPLOY_KNOWN_HOSTS
#
# Secrets    DEPLOY_HOST                  example.com, or an IP
#            DEPLOY_PORT                  optional; 22 when unset
#            DEPLOY_USER                  the account you ssh in as; it needs the
#                                         docker group
#            DEPLOY_SSH_KEY               the whole private key file, including
#                                         the BEGIN and END lines
#            DEPLOY_KNOWN_HOSTS           the server's host key line; the deploy
#                                         trusts no other key
#            DEPLOY_PATH                  the folder for the compose files and
#                                         this file: absolute, or relative to
#                                         the home folder without a leading ~
#            JWT_SECRET                   as above
#            POSTGRES_PASSWORD            as above, set before the first deploy
#            DATA_ENCRYPTION_KEY          as above, your own; losing it loses
#                                         every stored order's details
#            RABBITMQ_PASSWORD            as above, set before the first deploy
#            MAILPIT_PASSWORD             as above, your own
#            STRIPE_SECRET_KEY            optional, as above
#            STRIPE_PUBLISHABLE_KEY       optional, as above
#            STRIPE_WEBHOOK_SECRET        required with the Stripe keys: the
#                                         signing secret of the endpoint below
#            RECAPTCHA_SITE_KEY           optional, as above
#            RECAPTCHA_SECRET_KEY         optional, as above
#            OAUTH_GOOGLE_CLIENT_ID       optional, as above
#            OAUTH_GOOGLE_CLIENT_SECRET   optional, as above
#            OAUTH_GITHUB_CLIENT_ID       optional, as above
#            OAUTH_GITHUB_CLIENT_SECRET   optional, as above
#            ADMIN_PASSWORD               required: the first admin's password
#            ADMIN_TOTP_SECRET            required: the first admin's 2FA key,
#                                         made with the command above
#
# Variables  PUBLIC_WEB_URL               https://shop.example.com; required,
#                                         no default, must match the real address
#            WEB_PORT                     8090 by default; loopback only
#            MAILPIT_PORT                 8026 by default; loopback only
#            RABBITMQ_UI_PORT             15672 by default; loopback only
#            MAIL_FROM                    Prism <noreply@shop.example.com>
#            SUPPORT_EMAIL                the contact form's inbox
#            ADMIN_EMAIL                  required: the first admin's sign-in
#
# With Stripe keys, register a webhook endpoint in the dashboard (Developers >
# Webhooks) at <PUBLIC_WEB_URL>/api/v1/payments/webhook for
# payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled and refund.updated, and copy its whsec_ signing
# secret into STRIPE_WEBHOOK_SECRET. The server does not run the stripe
# profile.
#
# Then point the subdomain at WEB_PORT, and the inbox at MAILPIT_PORT. Mailpit
# asks for its own login, so the proxy adds none:
#
#   shop.example.com      { reverse_proxy 127.0.0.1:8090 }
#   mail.shop.example.com { reverse_proxy 127.0.0.1:8026 }
